{
    "name": "estoque/sistema",
    "description": "Sistema de Gerenciamento de Estoque",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Estoque\\": "src/"
        },
        "files": [
            "includes/funcoes.php"
        ]
    },
    "config": {
